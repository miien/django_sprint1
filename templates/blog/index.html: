<!DOCTYPE html>
<html>
<head>
    <title>Главная страница</title>
</head>
<body>
    <h1>Публикации в ленте</h1>
    {% for post in posts %}
    <article>
        <h2>{{ post.location }}</h2>
        <p>{{ post.date }}</p>
        <p>{{ post.category }}</p>
        <p>{{ post.text|truncatewords:10 }}</p>
        <a href="{% url 'blog:post_detail' post.id %}">Читать полный текст</a>
    </article>
    {% endfor %}
</body>
</html>
